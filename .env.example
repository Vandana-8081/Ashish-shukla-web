# Required for live AI assistant replies. Keep the key server-side and set it
# in the local environment or your hosting provider's secret settings.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Meta Graph API social feeds. Keep all access tokens server-side.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Set this to a currently supported Graph API version, for example vXX.0.
META_GRAPH_API_VERSION=

# Gmail delivery for the contact form. Use a Google App Password (Google Account
# > Security > 2-Step Verification > App passwords), not the regular Gmail
# password. GMAIL_USER is the sending account; CONTACT_SENDER_EMAIL should match it.
CONTACT_RECEIVER_EMAIL=
CONTACT_SENDER_EMAIL=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# X (Twitter) API v2 posts for the home page feed. Server-only, never NEXT_PUBLIC_.
# With X_BEARER_TOKEN empty the site falls back to the official embedded timeline.
# X_USER_ID is optional; it is looked up once and logged if missing.
X_BEARER_TOKEN=
X_USER_ID=
